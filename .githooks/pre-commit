#!/bin/sh
# Blocks a commit unless lint, formatting and the backend test suite pass.
# Enable once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)/backend"

# Integration tests need a disposable *_test database; read it from .env.test when present.
if [ -z "$TEST_DATABASE_URL" ] && [ -f .env.test ]; then
  # .env.test may have CRLF endings or indented lines (Windows); normalise before sourcing.
  eval "$(tr -d '\015' < .env.test | sed -e 's/^ *//' -e '/^[A-Z_]*=/!d' -e 's/^/export /')"
fi
if [ -z "$TEST_DATABASE_URL" ]; then
  echo "WARNING: TEST_DATABASE_URL is not set, so database tests will be skipped." >&2
fi

echo "[pre-commit] ruff check"
uv run ruff check .
echo "[pre-commit] ruff format --check"
uv run ruff format --check .
echo "[pre-commit] pytest"
uv run pytest -q
echo "[pre-commit] all checks passed"
